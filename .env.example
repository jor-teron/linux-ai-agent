# linux-ai-agent env
# description: API keys, host, Telegram, optional settings
# env_version: 0.40 (40)

# Default provider: gemini | openai | xai | anthropic | deepseek | openrouter | deepinfra
# Local (no API key): ollama | llamacpp — see OLLAMA_BASE_URL / LLAMACPP_BASE_URL below
PROVIDER=gemini

# API keys (set the ones you use)
GEMINI_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
DEEPINFRA_API_KEY=

# --- API rate limits (online providers only) ---
# Applied before outbound LLM / media HTTP calls. Local ollama / llamacpp skipped.
# 0 = that knob is off.
# API_DELAY_SEC: min seconds between calls (default 5). Waits if the gap is <= ~60s.
# RPM: max requests per rolling minute (default 14).
# RPD: max requests per local calendar day (default 500). Exhausted = hard error until tomorrow.
# TPM: max estimated tokens per minute (default 0 = off). Estimate = max(1, chars//4).
# API limits. 0 = no limit for that knob.
TPM=0
RPM=14
RPD=500
API_DELAY_SEC=5

# Optional default model per provider (must be in that provider's allowlist)
# GEMINI_MODEL=gemini-3.5-flash-lite
# OPENAI_MODEL=gpt-4o-mini
# XAI_MODEL=grok-4.3
# ANTHROPIC_MODEL=claude-haiku-4-5
# DEEPSEEK_MODEL=deepseek-chat
# OPENROUTER_MODEL=openrouter/auto
# DEEPINFRA_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# Listen address. 127.0.0.1 = this PC only. 0.0.0.0 = LAN / Tailscale.
# With HOST=0.0.0.0, localhost on the PC still works; phone uses Tailscale IP.
HOST=127.0.0.1
PORT=9191

# Absolute base URL for web /api/download links (browser on phone / Tailscale / LAN).
# Empty = relative links only (browser same-origin). No trailing slash required.
# Telegram is text-only and does not attach files. PUBLIC_BASE_URL remains useful
# for the web UI download links.
# Example: HOST=0.0.0.0 and PUBLIC_BASE_URL=http://100.100.50.XXX:9191
# PUBLIC_BASE_URL=http://100.100.50.XXX:9191
PUBLIC_BASE_URL=

# Agent jail (whole tree). Default = ~/ai-workspace
# Subdirs: chats/ memory/ workspace/ workspace/generated/ test/ trash/ user/
# Prefer workspace/ for new agent work; generated/ holds Image/Video output.
# user/ is agent read-only (list/read OK).
# WORKSPACE=/home/myname/ai-workspace

# Session memory (memory/session.md) auto-clear:
# If neither is set, session older than 24h is cleared.
# If both are set, either condition clears it.
# SESSION_RESET_HOURS=24
# SESSION_RESET_AFTER=01:00

# Optional Telegram DM bridge (long polling — no public URL / webhook).
# 1) Message @BotFather → /newbot → paste token below
# 2) DM your bot once; if ALLOWED is empty the bot replies with your chat id
# 3) Set TELEGRAM_ALLOWED_CHAT_ID and restart
# Telegram is text chat only for now (no photo / video / document sends).
# Photos get a short text reply. /image /video /vision are normal chat text.
# Shell confirm is still YES / NO (sudo: YES password).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
# Optional overrides (else PROVIDER / default model):
# TELEGRAM_PROVIDER=gemini
# TELEGRAM_MODEL=gemini-3.5-flash-lite

# Optional: install bubblewrap (apt install bubblewrap) for sandboxed shell freehand.
# Without bwrap, shell commands still need UI Confirm / Telegram YES-NO.

# --- Shell / sudo ---
# ALLOW_SUDO=1 (default): agent may queue sudo (always Confirm / Telegram YES [password]).
# ALLOW_SUDO=0: refuse sudo entirely.
ALLOW_SUDO=1
# Shell network: default ON (even inside bubblewrap). SHELL_NET=0 adds --unshare-net.
SHELL_NET=1
# SHELL_NET=0

# --- Token trim / tools ---
# TOOLS_DEFAULT=0 (default): chat API calls omit tool schemas unless the UI
# Tools toggle is on, or the message matches tool keywords (run, shell, file, …).
# TOOLS_DEFAULT=1: always send tools (higher token use).
TOOLS_DEFAULT=0
# Prior chat turns sent to the model (default 10).
HISTORY_TURNS=10

# --- Status LED (UI) ---
# Red LED blink period in ms when not ready (missing key / local runtime).
# Green is solid (no blink). Short text: OK / No key / No model.
# No UI control — .env only.
STATUS_BLINK_MS=2000

# --- Local runtimes (optional; not installed by install.sh) ---
# Ollama OpenAI-compat: http://127.0.0.1:11434/v1/chat/completions
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional: OLLAMA_MODEL=llama3.2:3b
# llama.cpp server (llama-server) OpenAI-compat on :8080
LLAMACPP_BASE_URL=http://127.0.0.1:8080
# Optional: LLAMACPP_MODEL=llama-3.2-3b

# --- Soft light theme (optional UI color overrides) ---
# Empty = built-in soft gray defaults (no pure white). Hex only: #rgb or #rrggbb.
# Applied by the browser while light theme is active (dark theme unchanged).
UI_LIGHT_BG=
UI_LIGHT_PANEL=
UI_LIGHT_BORDER=
UI_LIGHT_TEXT=
UI_LIGHT_MUTED=
UI_LIGHT_USER=
UI_LIGHT_BOT=
UI_LIGHT_BOT_BORDER=
UI_LIGHT_INPUT=
